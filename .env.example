# --- Claude ---
# Or run `ant auth login` instead of setting a key.
ANTHROPIC_API_KEY=sk-ant-...
GUARDIAN_MODEL=claude-opus-5
# low | medium | high | xhigh | max
GUARDIAN_EFFORT=high

# --- SentinelOne ---
# Console URL, no trailing slash, e.g. https://usea1-partners.sentinelone.net
GUARDIAN_S1_BASE_URL=
GUARDIAN_S1_API_TOKEN=
# Seconds between polls of the S1 threats API
GUARDIAN_S1_POLL_INTERVAL=60
# Set false to run the API without the background poller (useful for local dev)
GUARDIAN_S1_POLL_ENABLED=true

# --- Service ---
GUARDIAN_HOST=0.0.0.0
GUARDIAN_PORT=8000
GUARDIAN_LOG_LEVEL=INFO
# Shared secret required on inbound webhook posts (X-Guardian-Token)
GUARDIAN_WEBHOOK_TOKEN=
