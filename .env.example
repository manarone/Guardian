# --- Model provider (all three values are required) ---
# Example: Neuralwatt's OpenAI-compatible API. Replace these with your provider.
GUARDIAN_PROVIDER=openai
GUARDIAN_BASE_URL=https://api.neuralwatt.com/v1
GUARDIAN_API_KEY=
GUARDIAN_MODEL=glm-5.3-flash
# low | medium | high | xhigh | max
GUARDIAN_EFFORT=high

# For a native Anthropic Messages endpoint instead:
# GUARDIAN_PROVIDER=anthropic
# GUARDIAN_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# --- SentinelOne ---
GUARDIAN_S1_BASE_URL=
GUARDIAN_S1_API_TOKEN=
GUARDIAN_S1_POLL_INTERVAL=60
GUARDIAN_S1_POLL_ENABLED=true

# --- Service ---
GUARDIAN_HOST=0.0.0.0
GUARDIAN_PORT=8000
GUARDIAN_LOG_LEVEL=INFO
GUARDIAN_WEBHOOK_TOKEN=
# Set true only for local development.
GUARDIAN_ALLOW_UNAUTHENTICATED=false
